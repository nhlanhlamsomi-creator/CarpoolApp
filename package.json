{
  "name": "lyft-passenger",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --runInBand --watch=false",
    "coverage": "jest --runInBand --coverage --watch=false"
  },
  "jest": {
  "preset": "react-native",
  "testPathIgnorePatterns": [
    "/node_modules/",
    "tests/checkIdService.test.ts",
    "tests/kmeans.test.ts",
    "tests/passwordHash.test.ts",
    "tests/safety.test.ts"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@react-native|react-native|expo|@expo|@clerk|@stripe|@supabase|nativewind|react-native-css-interop)/)"
  ],
  "collectCoverageFrom": [
    "lib/**/*.{js,jsx,ts,tsx}",
    "app/**/*.{js,jsx,ts,tsx}",
    "!**/*.test.{js,jsx,ts,tsx}",
    "!**/node_modules/**"
  ]
},
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@clerk/backend": "^3.16.13",
    "@clerk/clerk-expo": "^2.19.31",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@neondatabase/serverless": "^1.1.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@stripe/stripe-react-native": "0.64.0",
    "@supabase/supabase-js": "^2.109.0",
    "argon2": "^0.45.1",
    "babel-preset-expo": "~57.0.0",
    "base64-arraybuffer": "^1.0.2",
    "dotenv": "^17.4.2",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-places-autocomplete": "^2.6.5",
    "react-native-maps": "1.27.2",
    "react-native-maps-directions": "^1.9.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-swiper": "^1.6.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "stripe": "^22.3.2",
    "tailwindcss": "^3.4.19",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true
}
